# Copy to .env and fill in. .env is gitignored - never commit it.
#   cp .env.example .env
#
# Required to mine and submit:  MAINNET_RPC_URL, MINER_PRIVATE_KEY,
#                               NTFY_TOPIC, NTFY_STATUS_TOPIC
# Required to rent GPUs:        VASTAI_API_KEY
# Required for competition.py:  ETHERSCAN_API_KEY

# ---------------------------------------------------------------------------
# LOCAL submission (submit_nonce.py) - runs on your machine ONLY.
# Nothing in this section ever reaches a rented GPU.
# ---------------------------------------------------------------------------

# Alchemy is preferred: public RPCs rate-limit and sometimes serve stale state,
# and stale state here means submitting a nonce that is already dead.
# Free tier is fine for this (it only limits eth_getLogs, which only
# competition.py needs - and that uses Etherscan instead).
# Get one at https://dashboard.alchemy.com
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# The wallet that calls mint(). Needs a little ETH for gas, nothing more.
# USE A BURNER. Never put this on a mining instance, never commit it.
MINER_PRIVATE_KEY=

HTK_CONTRACT=0xe5544a2a5fa9b175da60d8eec67add5582bb31b0

# ---------------------------------------------------------------------------
# ntfy topics - HOW YOUR MINERS TALK TO YOU
#
# !! GENERATE YOUR OWN. The values shipped as defaults in the code come from a
# !! PUBLIC GitHub repo, so anyone can subscribe to them, watch your nonces
# !! appear, and mint with them before you do. ntfy topics are unauthenticated:
# !! the topic name IS the password.
#
# Make private ones:
#   python3 -c "import secrets;print('htk-nonce-'+secrets.token_hex(12));print('htk-status-'+secrets.token_hex(12))"
# ---------------------------------------------------------------------------
NTFY_TOPIC=
NTFY_STATUS_TOPIC=

# ---------------------------------------------------------------------------
# How the mint transaction reaches a block.
#   flashbots  (default) - private, cannot be front-run. Recommended.
#   mevblocker / beaver  - other private relays
#   public               - your own RPC. Exposes the nonce in the mempool, where
#                          any bot can copy it and mint ahead of you, because
#                          mint(bytes32) is not bound to msg.sender.
# ---------------------------------------------------------------------------
SUBMIT_RELAY=flashbots

# A failed mint burns the ENTIRE gas limit (2016-era `throw` = INVALID opcode).
# A successful mint costs exactly 38,721 gas, so keep this tight.
GAS_LIMIT=60000
MAX_GAS_GWEI=50
PRIORITY_FEE_GWEI=0.05

# ---------------------------------------------------------------------------
# vast.ai provisioning (deploy.py) and monitoring (monitor.py)
# ---------------------------------------------------------------------------
# https://cloud.vast.ai/account/
VASTAI_API_KEY=

# Alert when a token is projected/realised to cost more than this, in USD.
COST_PER_TOKEN_ALERT=50

# ---------------------------------------------------------------------------
# competition.py - on-chain mining activity analysis
# ---------------------------------------------------------------------------
# Free key from https://etherscan.io/apis. Needed because Alchemy's free tier
# caps eth_getLogs at a 10-block range, which cannot scan Mint event history.
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Set automatically by deploy.py on each rented instance - you do not set these.
# Listed here only so the variable names are documented:
#   RIG_NAME           label for the rig in heartbeats
#   VAST_HOURLY_RATE   that instance's $/hr, for cost tracking
#   GPU_DESC           e.g. "8x RTX 3080"
# ---------------------------------------------------------------------------
